# Telegram
TELEGRAM_BOT_TOKEN=

# Existing NovaAI AI provider (used by the main bot)
AI_API_KEY=

# Optional fal.ai provider for the legacy AI-generation engine
FAL_KEY=
VIDEO_MODEL=alibaba/wan-3.0/reference-to-video

# Smart montage settings: user videos are analyzed locally; FAL_KEY is not required.
VIDEO_ASPECT_RATIO=9:16
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_MAX_TELEGRAM_MB=20
VIDEO_MAX_INPUTS=20
VIDEO_MAX_CLIPS=18
VIDEO_MAX_OUTPUT_SECONDS=60
VIDEO_RESOLUTION=1080p
VIDEO_FONT_NAME=DejaVu Sans
